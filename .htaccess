# ============================================================
#  tmfus.com — Apache config
#  Place this file in public_html (same folder as index.html)
# ============================================================

Options -Indexes
DirectoryIndex index.html

# ------------------------------------------------------------
#  Redirects
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  #    Namecheap's SSL plugin may already do this. Harmless if both
  #    are active. If you ever see a redirect loop, delete this block.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. www -> bare domain
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2b. The term-loans page was replaced by the SBA page. This must come
  #     before the rules below: rule 4 would otherwise rewrite
  #     /long-term-loans to a file that no longer exists and 404.
  RewriteRule ^long-term-loans(\.html)?/?$ /sba-loans [R=301,L]

  # 3. Strip .html so /heloc-calculator works as a URL.
  #    Existing .html URLs redirect to the clean version so you
  #    never have two addresses serving the same page.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 4. Serve the real file for the clean URL
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ------------------------------------------------------------
#  Caching — assets are cached hard, HTML never is.
#  This is what makes re-uploads show up immediately.
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
  # CSS/JS are referenced by stable filenames, so they must stay revalidatable
  # or edits never reach returning visitors. Cheap: revalidation is a 304.
  ExpiresByType text/css              "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Content-addressed by name only — never mark these immutable, or a redeploy
  # of styles.css / app.js is invisible to anyone who has already visited.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # Images and fonts are safe to pin: when they change, the filename changes.
  <FilesMatch "\.(svg|png|jpe?g|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Basic hardening
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------
#  Compression
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
#  Error pages
# ------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------
#  Block access to files that should never be public
# ------------------------------------------------------------
<FilesMatch "^\.|\.(md|py|json|lock|yml|yaml|zip|log|bak)$">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------
#  Protect API config and logs
#  figure-heloc.php must stay reachable; everything else in /api
#  is either a credential or a log and must never be served.
# ------------------------------------------------------------
<FilesMatch "^(config\.php|config\.example\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.log$">
  Require all denied
</FilesMatch>
