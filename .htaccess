# ============================================================
#  tmfus.com — Apache config
#  Place this file in public_html (same folder as index.html)
# ============================================================

Options -Indexes
DirectoryIndex index.html

# ------------------------------------------------------------
#  Redirects
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  #    Namecheap's SSL plugin may already do this. Harmless if both
  #    are active. If you ever see a redirect loop, delete this block.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. www -> bare domain
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2b. Keep the homepage on one URL. The explicit /index rule handles the
  #     clean duplicate; THE_REQUEST prevents the DirectoryIndex subrequest
  #     for / from redirecting in a loop.
  RewriteRule ^index/?$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^home(\.html)?/?$ / [R=301,L]

  # 2c. The term-loans page was replaced by the SBA page. This must come
  #     before the rules below: rule 4 would otherwise rewrite
  #     /long-term-loans to a file that no longer exists and 404.
  RewriteRule ^long-term-loans(\.html)?/?$ /sba-loans [R=301,L]

  # 2d. The 2026 redesign was drafted with these slugs. The live URLs won, so
  #     inbound links, the sitemap and emailed links keep working, but any
  #     link made from a draft still lands on the right page. Accept the old
  #     .html form directly so it takes one redirect, not two.
  RewriteRule ^calculator(\.html)?/?$ /funding-estimator [R=301,L]
  RewriteRule ^cash-injection(\.html)?/?$ /mca [R=301,L]
  RewriteRule ^home-equity(\.html)?/?$ /heloc-calculator [R=301,L]
  RewriteRule ^admin/?$ /admin.php [R=301,L]

  # 3. Strip .html so /heloc-calculator works as a URL.
  #    Existing .html URLs redirect to the clean version so you
  #    never have two addresses serving the same page.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 4. Serve the real file for the clean URL
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ------------------------------------------------------------
#  Caching — assets are cached hard, HTML never is.
#  This is what makes re-uploads show up immediately.
# ------------------------------------------------------------
# AVIF twins of the WebP images (issue #23). Older Apache/LiteSpeed builds
# do not know the type; declare it rather than rely on the browser sniffing
# an application/octet-stream response (this file sends nosniff).
<IfModule mod_mime.c>
  AddType image/avif .avif
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
  # CSS/JS are referenced by stable filenames, so they must stay revalidatable
  # or edits never reach returning visitors. Cheap: revalidation is a 304.
  ExpiresByType text/css              "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/avif            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType video/mp4             "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Content-addressed by name only — never mark these immutable, or a redeploy
  # of styles.css / app.js is invisible to anyone who has already visited.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # Images and fonts are safe to pin: when they change, the filename changes.
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Basic hardening
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # HTTPS-only (HSTS). OFF until about one week after launch, once https has
  # worked without a hiccup. Browsers remember this, so it is hard to undo:
  # if the certificate ever lapses, visitors cannot reach the site at all.
  # Step 1 (week 1 after launch): remove the # from the 1-day line below.
  # Step 2 (a week later, still fine): put the # back on it and remove the #
  # from the 1-year line. No preload and no includeSubDomains on purpose:
  # cPanel/mail subdomains may not all have certificates.
  # Header always set Strict-Transport-Security "max-age=86400" "expr=%{HTTPS} == 'on'"
  # Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# ------------------------------------------------------------
#  Content-Security-Policy (public pages)
#  The block below is rewritten by `node build.mjs`: the policy and the
#  inline-script hashes live in build.mjs. Do not edit it by hand.
# ------------------------------------------------------------
# BEGIN CSP (generated by build.mjs from its CSP list; edit there, then rebuild)
<IfModule mod_headers.c>
  # Public pages only. admin.php sends its own, stricter, enforcing policy.
  # REPORT-ONLY: logs would-be violations in the browser console, blocks
  # nothing. DEPLOY.md says when and how to switch to enforcing.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ https://cdn.jsdelivr.net/npm/lenis@1.3.4/ 'sha256-DOSsl9GprwqcFU6CYeQ49zXPX03388tCaU3cQBn68gM=' 'sha256-bMZiLsCX3tP1RADc9WGOIWBqZ2M614MA7GLZQq3X/bM=' 'sha256-xfeBIBWeomOA0/OQN0dD8R0OEZ6EwCAnciO134kQEc4='; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  </FilesMatch>
</IfModule>
# END CSP

# ------------------------------------------------------------
#  Compression
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
#  Error pages
# ------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------
#  Block access to files that should never be public
# ------------------------------------------------------------
<FilesMatch "^\.|\.(md|py|sh|json|lock|yml|yaml|zip|log|bak|mjs|gs)$">
  Require all denied
</FilesMatch>

# The scroll film reads its frame list from /media/film/frames/manifest.json.
# The rule above denies every .json, which would break the film on the server
# while it works perfectly on a local dev server (no .htaccess there). Later
# sections win in Apache, so this one exception must stay BELOW the deny.
<Files "manifest.json">
  Require all granted
</Files>

# Security review 2026-10. More files that must never be served:
#  - error_log: cPanel's PHP writes its warnings to a file with exactly this
#    name, no extension, in the folder of the script that failed (so
#    api/error_log). The .log rule above does not match it, and it holds
#    server paths and whatever the endpoints logged.
#  - data and config shapes nobody should download: csv (the monthly leads
#    export), jsonl (the opt-out list), sql dumps, env/ini files, editor and
#    backup leftovers (swp, old, orig, dist, tmp), and PHP source saved under
#    a name that does not run (inc, phps).
#  Nothing the site legitimately serves uses any of these.
<FilesMatch "(^error_log$|\.(csv|jsonl|sql|env|ini|swp|old|orig|dist|tmp|inc|phps)$)">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------
#  Protect API config and logs
#  figure-heloc.php must stay reachable; everything else in /api
#  is either a credential or a log and must never be served.
# ------------------------------------------------------------
<FilesMatch "^(config\.php|config\.example\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.log$">
  Require all denied
</FilesMatch>

# admin.php's lock library only defines functions, and the two PHP tools are
# command-line only (tools/ is never deployed and is 404'd below). Denied by
# name as well, so a stray copy in the web root can never be run from a browser.
<FilesMatch "^(admin-lock|totp-setup|hash-password)\.php$">
  Require all denied
</FilesMatch>

# Key material. The public key is not a secret, but this is the safety net
# for the day someone saves the PRIVATE key here by mistake. Applications
# are only as private as that file — it belongs on John's own machine.
<FilesMatch "\.(pem|key|crt|p12|pfx)$">
  Require all denied
</FilesMatch>

# Encrypted applications, if application_dir was ever left inside the web
# root. Ciphertext is not readable, but it should not be downloadable either.
<FilesMatch "\.enc\.json$">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------------
# Applicant bank statements.
#
# api/application.php writes here. These are customer financial
# documents and must never be reachable over the web — not by guessing
# a filename, not by listing the folder.
#
# Better still: set 'application_dir' in api/config.php to a path
# outside public_html. This block is the fallback for when it is not.
# ------------------------------------------------------------------
RedirectMatch 404 ^/api/uploads(/.*)?$

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Build sources and tooling. .cpanel.yml never copies them to the server;
# this is the safety net if a folder is ever uploaded by hand.
RedirectMatch 404 ^/(src|tools|docs|scripts|node_modules)(/.*)?$
