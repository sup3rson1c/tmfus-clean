# local scratch
*.zip
verify.py
shot*.py
*.png
!assets/**/*.png

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Figure API credentials — the repo is public, this must never be committed
api/config.php
api/figure-errors.log

# Applicant bank statements written by api/application.php.
# Customer financial documents — never commit these.
api/uploads/

# Key material. The private key that decrypts applications belongs on
# John's machine and NOWHERE else. If one is ever committed, regenerate the
# pair and re-key every application — assume the old one is compromised.
*.pem
*.key
*.p12
*.pfx
tmf-private-key*

# The bundled Obsidian notes the chat assistant reads. Produced by
# scripts/bundle-vault.py, uploaded by hand to the protected folder outside
# public_html. They are John's own notes about how TMF works and who it deals
# with — the repo is public, so they must never land in it.
tmf-knowledge.md
*-knowledge.md
knowledge.md
knowledge.txt

# Encrypted applications and chat transcripts, if application_dir was ever
# pointed somewhere inside the repo.
*.enc.json
chats/
leads/
